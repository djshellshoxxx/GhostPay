# GhostPay environment variable NAMES only. Copy to a private, git-ignored file (for example `.env`)
# and fill in values on the machine that needs them. NEVER commit values: no keys, no RPC URLs that
# contain provider keys, no passphrases. CI rejects committed env files and key material.
#
# Nothing in the web app reads environment variables at runtime (it is a static bundle).
# Sources of truth for each name: apps/relayer/README.md (relayer), packages/contracts/script/*.s.sol
# header comments (deploy), scripts/ and docs/operators/release-and-verify.md (release).

# ---------------------------------------------------------------------------
# Relayer (apps/relayer). Set either the *_FILE or the direct variable, preferring the file
# (regular file, chmod 600, owned by the service user).
# ---------------------------------------------------------------------------
RELAYER_KEY_FILE=
RELAYER_KEY=
QUOTE_SECRET_FILE=
QUOTE_SECRET=
# Path to the JSON config (default ./relayer.config.json) and the directory of <chainId>.json manifests.
RELAYER_CONFIG=
DEPLOYMENTS_DIR=
# Set to 1 only for non-testnet chains, after the chain-enablement checklist is complete.
ALLOW_MAINNET=
# One RPC URL variable per chain; the variable NAME is chosen by `rpcUrlEnv` in the config
# (the example config uses RPC_URL_84532 for Base Sepolia).
RPC_URL_84532=
# In progress (relayer metrics / alerts): the names are chosen in the config by
# `metrics.bearerTokenEnv` and `alerts.webhookUrlEnv`. Example names only:
METRICS_BEARER_TOKEN=
ALERT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Contract deployment (packages/contracts/script). Use a keystore or hardware wallet to sign
# (--account / --ledger); never put a private key in this file.
# ---------------------------------------------------------------------------
# Deploy.s.sol and DeployPolicy.s.sol
FEE_RECIPIENT=
ALLOWED_CHAIN_IDS=
ALLOW_LOCAL=
# Deploy.s.sol only
ANNOUNCER=
ALLOW_CUSTOM_ANNOUNCER=
EXPECTED_ANNOUNCER_CODEHASH=
# DeployPolicy.s.sol only (experimental policy accounts; see ADR-0014)
FEE_TOKEN=
FLAT_FEE=
MAX_FLAT_FEE=
# Shell convenience used in the runbooks (`--rpc-url "$RPC"`), not read by the scripts themselves.
RPC=

# ---------------------------------------------------------------------------
# Tests and tooling
# ---------------------------------------------------------------------------
# Path to the anvil binary for the relayer and chain-adapters end-to-end tests
# (the relayer test defaults to /home/user/tools/foundry/anvil).
ANVIL_BIN=
# 1 makes a missing anvil FAIL the differential test instead of skipping it (in progress).
REQUIRE_ANVIL=

# ---------------------------------------------------------------------------
# Release scripts (scripts/*.sh; in progress, see docs/operators/release-and-verify.md)
# ---------------------------------------------------------------------------
SOURCE_DATE_EPOCH=
OUT_DIR=
VERSION=
