{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostpay.invalid/schemas/deployment-manifest.json",
  "title": "GhostPay deployment manifest",
  "description": "Per-chain record of a verified GhostPay contract deployment. File name: <chainId>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chainId",
    "announcer",
    "router",
    "sweepRelayer",
    "feeRecipient",
    "feeBps",
    "deployTx",
    "solcVersion",
    "commit",
    "bytecodeHashes",
    "date"
  ],
  "properties": {
    "chainId": { "type": "integer", "minimum": 1 },
    "announcer": { "$ref": "#/$defs/address" },
    "router": { "$ref": "#/$defs/address" },
    "sweepRelayer": { "$ref": "#/$defs/address" },
    "feeRecipient": { "$ref": "#/$defs/address" },
    "feeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "deployTx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["router", "sweepRelayer"],
      "properties": {
        "router": { "$ref": "#/$defs/bytes32" },
        "sweepRelayer": { "$ref": "#/$defs/bytes32" }
      }
    },
    "solcVersion": { "type": "string", "pattern": "^0\\.8\\.\\d+(\\+commit\\.[0-9a-f]{8})?$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "bytecodeHashes": {
      "type": "object",
      "description": "keccak256 of the deployed runtime bytecode read from the chain.",
      "additionalProperties": false,
      "required": ["router", "sweepRelayer"],
      "properties": {
        "router": { "$ref": "#/$defs/bytes32" },
        "sweepRelayer": { "$ref": "#/$defs/bytes32" }
      }
    },
    "date": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
