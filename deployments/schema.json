{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostpay.invalid/schemas/deployment-manifest.json",
  "title": "GhostPay deployment manifest",
  "description": "Per-chain record of a verified GhostPay contract deployment. File name: <chainId>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chainId",
    "announcer",
    "router",
    "sweepRelayer",
    "feeRecipient",
    "feeBps",
    "deployTx",
    "solcVersion",
    "commit",
    "bytecodeHashes",
    "date"
  ],
  "properties": {
    "chainId": { "type": "integer", "minimum": 1 },
    "announcer": { "$ref": "#/$defs/address" },
    "router": { "$ref": "#/$defs/address" },
    "sweepRelayer": { "$ref": "#/$defs/address" },
    "feeRecipient": { "$ref": "#/$defs/address" },
    "feeBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "policyImplementation": {
      "description": "Optional. Locked PolicyAccount implementation cloned by the policy factory (scheme 0x47500002).",
      "$ref": "#/$defs/address"
    },
    "policyFactory": {
      "description": "Optional. PolicyAccountFactory. When present, every other policy* field is required.",
      "$ref": "#/$defs/address"
    },
    "policyFeeToken": {
      "description": "Optional. Token in which the factory's F-SECURE flat fee is paid (factory FEE_TOKEN).",
      "$ref": "#/$defs/address"
    },
    "policyFlatFee": {
      "description": "Optional. Factory FLAT_FEE in fee-token base units, as a decimal string (may exceed 2^53).",
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    },
    "policyFeeRecipient": {
      "description": "Optional. Factory FEE_RECIPIENT (may differ from the router's).",
      "$ref": "#/$defs/address"
    },
    "deployTx": {
      "type": "object",
      "additionalProperties": false,
      "required": ["router", "sweepRelayer"],
      "properties": {
        "router": { "$ref": "#/$defs/bytes32" },
        "sweepRelayer": { "$ref": "#/$defs/bytes32" },
        "policyImplementation": { "$ref": "#/$defs/bytes32" },
        "policyFactory": { "$ref": "#/$defs/bytes32" }
      }
    },
    "solcVersion": { "type": "string", "pattern": "^0\\.8\\.\\d+(\\+commit\\.[0-9a-f]{8})?$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "bytecodeHashes": {
      "type": "object",
      "description": "keccak256 of the deployed runtime bytecode read from the chain.",
      "additionalProperties": false,
      "required": ["router", "sweepRelayer"],
      "properties": {
        "router": { "$ref": "#/$defs/bytes32" },
        "sweepRelayer": { "$ref": "#/$defs/bytes32" },
        "policyImplementation": { "$ref": "#/$defs/bytes32" },
        "policyFactory": { "$ref": "#/$defs/bytes32" }
      }
    },
    "date": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" }
  },
  "dependentRequired": {
    "policyFactory": [
      "policyImplementation",
      "policyFeeToken",
      "policyFlatFee",
      "policyFeeRecipient"
    ]
  },
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "bytes32": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
  }
}
