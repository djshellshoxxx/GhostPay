# Static-only listener used by infra/web/Dockerfile. No TLS, no relayer: terminate TLS (and add HSTS) in infra/proxy.
{
	auto_https off
	admin off
}

:8080 {
	encode zstd gzip
	log {
		output discard
	}

	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https: wss:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; worker-src 'self'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Permissions-Policy "accelerometer=(), autoplay=(), bluetooth=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), xr-spatial-tracking=()"
		Cross-Origin-Opener-Policy "same-origin"
		# COEP: all subresources are same-origin; cross-origin RPC fetches are CORS requests, which COEP allows.
		Cross-Origin-Embedder-Policy "require-corp"
		-Server
	}

	handle /deployments/* {
		header Cache-Control "no-store"
		header Cross-Origin-Resource-Policy "same-origin"
		root * /srv/ghostpay
		file_server
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		header Cross-Origin-Resource-Policy "same-origin"
		root * /srv/ghostpay
		file_server
	}
	handle /ghostpay-embed-v1.js {
		header Cache-Control "public, max-age=3600"
		header Cross-Origin-Resource-Policy "cross-origin"
		root * /srv/ghostpay
		file_server
	}
	handle {
		header Cache-Control "no-cache"
		root * /srv/ghostpay
		try_files {path} /index.html
		file_server
	}
}
