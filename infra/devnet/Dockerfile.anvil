# UNTESTED. Foundry toolchain + the repository (for forge scripts and the node helpers). Build context = repo root.
# Pin the image digest before relying on this; `latest` is a placeholder.
FROM ghcr.io/foundry-rs/foundry:latest AS foundry

FROM node:22-bookworm-slim
COPY --from=foundry /usr/local/bin/forge /usr/local/bin/cast /usr/local/bin/anvil /usr/local/bin/
WORKDIR /repo
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/relayer/package.json ./apps/relayer/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY scripts ./scripts
COPY deployments ./deployments
RUN npm ci --ignore-scripts && npm run build:libs
# foundry.toml pins a sandbox-local solc path; fall back to the downloadable compiler inside the image.
ENV FOUNDRY_SOLC_VERSION=0.8.28
RUN cd packages/contracts && sed -i '/^solc = /d' foundry.toml && forge build
EXPOSE 8545
