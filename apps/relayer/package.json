{
  "name": "@ghostpay/relayer",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run build -w @ghostpay/chain-adapters && npm run build -w @ghostpay/relayer-guard && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint --config ../../eslint.config.js src",
    "start": "node dist/main.js",
    "ops": "node dist/ops.js",
    "smoke:container": "bash deploy/smoke-anvil.sh"
  },
  "dependencies": {
    "@ghostpay/chain-adapters": "0.1.0",
    "@ghostpay/relayer-guard": "0.1.0",
    "viem": "2.58.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.1.1",
    "fast-check": "4.11.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "description": "GhostPay gas-sponsorship relay service (node:http, viem).",
  "engines": {
    "node": ">=22"
  }
}
