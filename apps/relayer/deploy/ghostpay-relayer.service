# Example systemd unit. Contains no secrets. LoadCredential stages root-owned files in a private credential
# directory readable by the service user, which satisfies the relayer's ownership and mode checks.
[Unit]
Description=GhostPay gas-sponsorship relayer
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=ghostpay-relayer
Group=ghostpay-relayer
WorkingDirectory=/opt/ghostpay/apps/relayer
ExecStart=/usr/bin/node dist/main.js
Environment=NODE_ENV=production
Environment=RELAYER_CONFIG=/etc/ghostpay-relayer/relayer.config.json
Environment=DEPLOYMENTS_DIR=/etc/ghostpay-relayer/deployments
LoadCredential=hot.key:/etc/ghostpay-relayer/hot.key
LoadCredential=quote.secret:/etc/ghostpay-relayer/quote.secret
# For a quote-secret rotation, also add: LoadCredential=quote.secret.previous:/etc/ghostpay-relayer/quote.secret.previous
Environment=RELAYER_KEY_FILE=%d/hot.key
Environment=QUOTE_SECRET_FILE=%d/quote.secret
# During rotation: Environment=QUOTE_SECRET_PREVIOUS_FILE=%d/quote.secret.previous
# RPC URLs with API keys: EnvironmentFile must be mode 600 and contain e.g. RPC_URL_84532=https://...
EnvironmentFile=/etc/ghostpay-relayer/rpc.env
# ALLOW_MAINNET=1 is deliberately NOT set here.
# Durable state (daily budget + unsettled transactions): /var/lib/ghostpay-relayer, created and owned by the service user.
# The config's state.file must be /var/lib/ghostpay-relayer/state.json. It is the ONLY writable path (ProtectSystem=strict).
StateDirectory=ghostpay-relayer
StateDirectoryMode=0700
ReadWritePaths=/var/lib/ghostpay-relayer
# Restart delay: the process holds a heartbeat lock <state>.lock (30 s staleness). A restart by systemd is a new pid, so
# the lock is taken over only once it is stale: keep RestartSec >= 10 and expect the first retries to be refused until
# then. StartLimit* (in [Unit]) stops a crash loop.
Restart=on-failure
RestartSec=15
# Graceful stop: shutdownGraceSeconds (default 15) must be shorter than this.
TimeoutStopSec=45
KillSignal=SIGTERM
LimitNOFILE=4096
MemoryMax=512M
TasksMax=128

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# V8 JIT needs writable+executable memory: MemoryDenyWriteExecute must stay off for node.
MemoryDenyWriteExecute=false
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A filtered call fails with EPERM instead of killing the process with SIGSYS (e.g. node adjusting RLIMIT_NOFILE).
SystemCallErrorNumber=EPERM
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
