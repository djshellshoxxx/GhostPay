# Copy to deploy/.env and edit. Contains NO secrets: secrets live in deploy/secrets/ (gitignored, see secrets/README.md).
# RPC URLs that embed API keys go in deploy/secrets/rpc.env (mode 600), never here.

# Host port the web+proxy container is published on (bound to 127.0.0.1 only). Put your TLS terminator in front of it.
GHOSTPAY_HTTP_PORT=8080

# Public origin users will visit. Must also appear in config/relayer.config.json "allowedOrigins".
GHOSTPAY_PUBLIC_ORIGIN=https://pay.example.org

# Directory holding the extracted, VERIFIED web bundle (must contain index.html). See BUILD-WEB.md.
GHOSTPAY_WEB_DIST=./web-dist

# Images. Prefer pinning by digest once you have checked them:  nginxinc/nginx-unprivileged:1.27-alpine@sha256:...
GHOSTPAY_NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine
# The relayer image is built locally from apps/relayer/Dockerfile (compose "build:"); this is only its local tag.
GHOSTPAY_API_IMAGE=ghostpay-relayer:local
# Tor image is built locally from deploy/tor/Dockerfile (profile "onion").
GHOSTPAY_TOR_IMAGE=ghostpay-tor:local
GHOSTPAY_TOR_BASE_IMAGE=debian:bookworm-slim

# Uid/gid the API container runs as (distroless nonroot). Secret files must be owned by this uid.
GHOSTPAY_API_UID=65532
