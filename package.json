{
  "name": "ghostpay",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:libs": "npm run build -w @ghostpay/core-crypto -w @ghostpay/invoice-schema && npm run build -w @ghostpay/chain-adapters",
    "ci:scan-secrets": "bash scripts/scan-secrets.sh",
    "ci:check-actions": "bash scripts/check-actions-pinned.sh",
    "release:build": "bash scripts/release-build.sh",
    "release:repro": "bash scripts/repro-check.sh"
  }
}
