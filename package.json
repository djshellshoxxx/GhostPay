{
  "name": "ghostpay",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "node scripts/build-workspaces.mjs",
    "build:libs": "node scripts/build-workspaces.mjs --libraries",
    "ci:scan-secrets": "bash scripts/scan-secrets.sh",
    "ci:check-actions": "bash scripts/check-actions-pinned.sh",
    "ci:check-tx-origin": "bash scripts/check-tx-origin.sh",
    "release:build": "bash scripts/release-build.sh",
    "release:repro": "bash scripts/repro-check.sh",
    "build:packages": "node scripts/build-workspaces.mjs --libraries",
    "build:cli": "node scripts/build-workspaces.mjs --workspace @ghostpay/cli",
    "test:cli-build": "node --test scripts/tests/build-cli.test.mjs"
  },
  "overrides": {
    "ws": "8.21.0",
    "underscore": "1.13.8",
    "@0xbow/privacy-pools-core-sdk": {
      "viem": "2.57.13"
    }
  }
}
