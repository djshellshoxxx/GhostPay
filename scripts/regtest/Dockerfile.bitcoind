# Bitcoin Core from the official release tarball, checked against a SHA-256 YOU supply (no default on purpose).
FROM debian:bookworm-slim
ARG BITCOIN_VERSION
ARG BITCOIN_SHA256
RUN test -n "$BITCOIN_VERSION" && test -n "$BITCOIN_SHA256" \
 && apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSL -o /tmp/bitcoin.tar.gz "https://bitcoincore.org/bin/bitcoin-core-${BITCOIN_VERSION}/bitcoin-${BITCOIN_VERSION}-x86_64-linux-gnu.tar.gz" \
 && echo "${BITCOIN_SHA256}  /tmp/bitcoin.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/bitcoin.tar.gz -C /opt && ln -s /opt/bitcoin-${BITCOIN_VERSION}/bin/bitcoind /usr/local/bin/bitcoind \
 && ln -s /opt/bitcoin-${BITCOIN_VERSION}/bin/bitcoin-cli /usr/local/bin/bitcoin-cli \
 && rm -rf /tmp/bitcoin.tar.gz /var/lib/apt/lists/* \
 && useradd -m bitcoin
USER bitcoin
EXPOSE 18443
