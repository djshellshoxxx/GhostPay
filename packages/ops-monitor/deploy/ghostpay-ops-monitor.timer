# Runs the monitor every 5 minutes. Install both files in /etc/systemd/system and:
#   systemctl enable --now ghostpay-ops-monitor.timer
[Unit]
Description=Run the GhostPay ops monitor every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
RandomizedDelaySec=20s
Persistent=true

[Install]
WantedBy=timers.target
