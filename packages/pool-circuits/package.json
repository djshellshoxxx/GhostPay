{
  "name": "@ghostpay/pool-circuits",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "circom 2.2.3 + snarkjs Groth16 circuits for the GhostPay testnet shielded pool (withdraw, ragequit). INSECURE DEV CEREMONY. GPL-3.0 toolchain isolated here (OWNER DECISION on repo licence).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:circuits": "bash scripts/build.sh",
    "check:verifiers": "bash scripts/check-verifiers.sh",
    "gen:vectors": "node scripts/gen-vectors.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint --config ../../eslint.config.js src test"
  },
  "dependencies": {
    "poseidon-lite": "0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "@zk-kit/lean-imt": "2.2.5",
    "ffjavascript": "0.3.1",
    "circomlib": "2.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "snarkjs": "0.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "viem": "2.57.10",
    "vitest": "5.0.5"
  }
}
