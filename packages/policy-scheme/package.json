{
  "name": "@ghostpay/policy-scheme",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "GhostPay scheme 0x47500002 (policy-guarded stealth account): derivation, limits tree, CREATE2 prediction, scanner, EIP-712 and calldata (experimental, ADR-0014).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build -w @ghostpay/core-crypto --if-present && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint --config ../../eslint.config.js src",
    "gen-abi": "bash scripts/gen-abi.sh",
    "gen-vectors": "node ../../test-vectors/generate-policy-scheme.mjs"
  },
  "dependencies": {
    "@ghostpay/core-crypto": "0.1.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@scopelift/stealth-address-sdk": "1.0.0-beta.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
