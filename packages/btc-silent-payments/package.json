{
  "name": "@ghostpay/btc-silent-payments",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "BIP-352 Silent Payments engine and Bitcoin ChainAdapter for GhostPay (MULTICHAIN_SPEC section 3).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "proto/blindbit"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint --config ../../eslint.config.js src"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "1.2.6",
    "@scure/btc-signer": "2.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@scure/bip32": "1.7.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
