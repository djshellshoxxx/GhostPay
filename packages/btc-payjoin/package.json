{
  "name": "@ghostpay/btc-payjoin",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "BIP-78 PayJoin policy core (sender/receiver checks), PayjoinTransport interface with memory and v1 HTTP transports, optional BIP-77 v2 adapter over payjoin-ffi. Testnet/signet/regtest only.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ffi": {
      "types": "./dist/ffi/index.d.ts",
      "default": "./dist/ffi/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint --config ../../eslint.config.js src e2e"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/btc-signer": "2.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "payjoin": "0.25.0"
  },
  "peerDependenciesMeta": {
    "payjoin": {
      "optional": true
    }
  }
}
