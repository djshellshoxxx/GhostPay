{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostpay.invalid/schema/webhook-event.v1.json",
  "title": "GhostPay webhook event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "createdAt",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,64}$",
      "description": "Idempotency key: process each id at most once."
    },
    "type": {
      "enum": [
        "invoice.paid",
        "invoice.partial",
        "invoice.over",
        "invoice.expired"
      ]
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoiceId",
        "currency",
        "amountMinor"
      ],
      "properties": {
        "invoiceId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "amountMinor": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,29})$",
          "description": "Cumulative amount received so far for the invoice (not a single payment), as a decimal integer in minor units of data.currency; a running total for every event type (partial, paid, over, expired). Normative definition: docs/remote/usability/specs/webhooks.md R8. A webhook is a notification, never payment proof: confirm with the canonical on-chain verifier."
        },
        "paymentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      }
    }
  }
}
