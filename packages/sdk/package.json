{
  "name": "@ghostpay/sdk",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "GhostPay typed SDK: client, invoice builder and verification, typed events, React hook factories.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/invoice.v1.schema.json": "./schema/invoice.v1.schema.json",
    "./schema/webhook-event.v1.schema.json": "./schema/webhook-event.v1.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint --config ../../eslint.config.js src",
    "emit:schema": "node scripts/emit-schema.mjs"
  },
  "dependencies": {
    "@ghostpay/invoice-schema": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
