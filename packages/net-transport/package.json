{
  "name": "@ghostpay/net-transport",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Transport profiles (Tor/I2P/Nym/OHTTP), SOCKS5h agent and config validation (testnet PoC).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @ghostpay/net-harness --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @ghostpay/net-harness --if-present",
    "test": "vitest run --coverage",
    "lint": "eslint --config ../../eslint.config.js src"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ghostpay/net-harness": "0.1.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@ghostpay/chain-adapters": "0.1.0",
    "@noble/hashes": "2.4.0",
    "viem": "2.57.10"
  }
}
