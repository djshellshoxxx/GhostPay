{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": true,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "types": [],
    "paths": {}
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mjs"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.testutil.ts"
  ]
}
