{
  "name": "@ghostpay/cli",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "GhostPay command line: invoices, webhooks, schedules, splits, batch payouts, exports, sandbox, doctor. Offline by default.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ghostpay": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "test:compiled": "node --test test/compiled.test.mjs test/operators.test.mjs",
    "lint": "eslint --config ../../eslint.config.js src"
  },
  "dependencies": {
    "@ghostpay/i18n": "0.1.0",
    "@ghostpay/invoice-schema": "0.1.0",
    "@ghostpay/merchant-billing": "0.1.0",
    "@ghostpay/merchant-hooks": "0.1.0",
    "@ghostpay/merchant-ledger": "0.1.0",
    "@ghostpay/sandbox": "0.1.0",
    "@ghostpay/core-crypto": "0.1.0",
    "@ghostpay/chain-adapters": "0.1.0",
    "@ghostpay/btc-silent-payments": "0.1.0",
    "@ghostpay/chain-solana": "0.1.0",
    "@ghostpay/chain-tron": "0.1.0",
    "@ghostpay/qr-exchange": "0.1.0",
    "@ghostpay/ux-vault": "0.1.0",
    "@ghostpay/merchant-multisig": "0.1.0",
    "@noble/hashes": "2.4.0",
    "@noble/curves": "2.4.0",
    "viem": "2.57.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
