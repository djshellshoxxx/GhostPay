{
  "name": "@ghostpay/chain-adapters",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "GhostPay EVM chain adapter: config, fee math, deployment manifests, router calldata, sweep signing, RPC, logs and quotes.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./deepscan": {
      "types": "./dist/deepscan.d.ts",
      "default": "./dist/deepscan.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "npm run build -w @ghostpay/core-crypto -w @ghostpay/invoice-schema --if-present && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage",
    "lint": "eslint --config ../../eslint.config.js src",
    "gen-abi": "bash scripts/gen-abi.sh"
  },
  "dependencies": {
    "@ghostpay/core-crypto": "0.1.0",
    "@ghostpay/invoice-schema": "0.1.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
