{
  "name": "@ghostpay/light-indexer",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Optional reference service for the public /v1/logs ERC-5564 announcement API (testnet PoC, unaudited, not deployed).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "npm run build -w @ghostpay/scan-source --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @ghostpay/scan-source --if-present",
    "test": "vitest run --coverage",
    "lint": "eslint --config ../../eslint.config.js src",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@ghostpay/scan-source": "0.1.0",
    "@noble/hashes": "2.4.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.15.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.0.5"
  }
}
