  "quality_gaps": [
    {
      "id": "E2E-G03",
      "title": "Camera lifecycle assertions lose visibility when video elements are removed",
      "classification": "qualification_gap",
      "scope": "test-support only",
      "confidence": "high (direct source)",
      "is_application_vulnerability": false,
      "status": {
        "main": "present; same reviewed test blobs",
        "candidate": "present; same reviewed test blobs"
      },
      "evidence": [
        {
          "path": "apps/web/e2e/qr-camera.spec.ts",
          "blob": "8c8b940002179e448bdba20b260c55d11837769b",
          "sha": "87cf6c603338ad64ec02300fe42b96c3e0a205b9",
          "ranges": [
            [
              23,
              27
            ],
            [
              33,
              54
            ]
          ]
        },
        {
          "path": "apps/web/e2e/qr-camera-multipart.spec.ts",
          "blob": "34286ecda0ec4ca376baf5900652c997e7786b0d",
          "sha": "87cf6c603338ad64ec02300fe42b96c3e0a205b9",
          "ranges": [
            [
              35,
              43
            ]
          ]
        }
      ],
      "detail": "The single-camera liveTracks observer enumerates document.querySelectorAll(video) and counts only live tracks on those current elements' srcObject streams. The multipart test uses the same current-DOM strategy. Zero live tracks is therefore also returned when the relevant video is removed or its srcObject is cleared; the assertions retain no reference to previously acquired streams. The navigation, stop and completion assertions cannot independently establish that all earlier capture tracks reached ended.",
      "impact": "These assertions establish that no live track remains reachable through the currently queried video elements. They do not fully qualify capture teardown after navigation or preview completion. A future regression that detaches a video while retaining a live stream could escape this particular observation. No actual application camera leak, failed stop operation, unauthorized capture or production vulnerability was established.",
      "recommendation": "In the test harness, retain observational references to streams returned by the real mediaDevices.getUserMedia call, establish successful acquisition on the successful path, and assert that every acquired video track reaches ended after explicit stop, route teardown and successful completion. Preserve the separate explicit-click and denied-permission checks.",
      "validation": "Static source inspection only. No browser, media device, test or application execution was performed."
    }
  ],
