    <section
      aria-labelledby="_r_c_"
      class="stack"
      data-testid="stealth-export-verification"
    >
      <h4
        id="_r_c_"
      >
        Keep and verify this backup
      </h4>
      <p
        aria-live="polite"
        data-testid="stealth-export-backup-state"
        role="status"
      >
        You confirmed keeping this backup. Recoverability is not yet verified.
      </p>
      <p
        class="hint"
      >
        Verification applies only to this file. It does not mark the complete seller keystore as backed up.
      </p>
      <div
        class="check"
      >
        <input
          id="_r_d_"
          type="checkbox"
        />
        <label
          for="_r_d_"
        >
          I saved this backup file and kept its passphrase separately.
        </label>
      </div>
      <form
        autocomplete="off"
        class="stack"
      >
        <div
          class="field"
        >
          <label
            for="_r_e_"
          >
            Saved backup file
          </label>
          <input
            accept="application/json,.json"
            id="_r_e_"
            type="file"
          />
          <p
            class="hint"
          >
            Selected file
            : 
            <bdi>
              <span
                class="isolate"
              >
                ghostpay-stealth-keypair.json
              </span>
            </bdi>
          </p>
        </div>
        <div
          class="field"
        >
          <label
            for="_r_f_"
          >
            Passphrase of the saved backup
          </label>
          <input
            autocomplete="off"
            disabled=""
            id="_r_f_"
            type="password"
            value="not the backup password"
          />
        </div>
        <button
          class="btn"
          disabled=""
          type="submit"
        >
          Verify the saved backup
        </button>
        <button
          class="btn"
          type="button"
        >
          Cancel
        </button>
      </form>
      <p
        role="status"
      >
        Decrypting and checking every key…
      </p>
    </section>
  </div>
</body>

