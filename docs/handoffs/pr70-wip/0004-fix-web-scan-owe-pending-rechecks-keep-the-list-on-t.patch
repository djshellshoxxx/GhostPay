+function routerPaymentsRpc(metaAddress: string, blocks: readonly number[], head: number, down: () => boolean) {
+  const payer = '0x2222222222222222222222222222222222222222' as Address;
+  const TOKEN = '0x036cbd53842c5426634e7929541ec2318f3dcf7e';
+  const logs = blocks.map((block) => makeLog({ announcer: FAKE_ANNOUNCER, metaAddress, block, index: 1, caller: FAKE_ROUTER }).log);
