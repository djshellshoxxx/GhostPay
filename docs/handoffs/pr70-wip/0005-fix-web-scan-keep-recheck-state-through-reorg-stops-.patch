   // The same notice from the stored checkpoint (ScanCursor.rescanFrom), so it outlives a later Scan click and a reload
   // until a scan from that block, or from before it, saves. The count is not stored, so this copy does not give one.
   const recheckNotice = recheckNote ?? (checkpoint?.rescanFrom === undefined ? undefined : t('scan.recheck.overflowSaved', { block: checkpoint.rescanFrom.toString() }));
