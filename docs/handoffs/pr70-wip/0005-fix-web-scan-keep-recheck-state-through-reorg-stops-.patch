+  it('H1: an uncorroborated anchor after a window-end reorg saves the page start, keeping what the checkpoint owes', async () => {
+    const s = setup(); const cp = memStore();
+    const paid = makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(s.keys), block: 2500, index: 0, caller: FAKE_ROUTER });
+    const logs = [paid.log];
+    // The second provider agrees on the page (both comparisons) and then reports another hash for the page-end anchor
