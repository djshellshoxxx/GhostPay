+describe('reorg stops keep what the checkpoint owes, and never skip blocks below a window-end reorg', () => {
+  const HEAD = 120_000;
+  const DIRECT = '0x9999999999999999999999999999999999999999' as Address;
+  const START = 2000n; // the page start of a resumed run
+  const ANCHOR = { number: START - 1n, hash: blockHash(Number(START) - 1) as Hex };
+  type Params = Parameters<typeof runScan>[0];
+  const memStore = () => {
+    const map = new Map<string, string>();
+    const saves: ScanCursor[] = [];
+    const storage = { getItem: (k: string) => map.get(k) ?? null, setItem: (k: string, v: string) => void map.set(k, v), removeItem: (k: string) => void map.delete(k) };
+    const store = localCheckpointStore(storage);
+    const recording: CheckpointStore = { ...store, save: (id, key, cursor) => { saves.push(cursor); store.save(id, key, cursor); } };
+    // A fresh store over the same storage, as after a reload.
+    return { map, saves, store: recording, reload: () => localCheckpointStore(storage) };
+  };
+  const scan = (s: ReturnType<typeof setup>, extra: Partial<Params> & Pick<Params, 'client'>) => runScan({
+    chain, manifest, cursor: { nextBlock: 0n },
+    spendingPublicKeyHex: hexOf(s.keys.spendingPublicKey), keyId: KEY,
+    viewingKey: unsafeRevealSecret(s.keys.viewingSecret), createWorker: () => new InlineWorker(), signal: new AbortController().signal,
+    ...extra,
+  });
+  /**
+   * The provider answers a different hash for `block` the first time it is asked, then the canonical one: a window ending
+   * there was processed on a fork, so the fetch reports a window-end reorg at that window's start (its `w.from`).
+   */
+  const windowEndFork = <C extends ReturnType<typeof chainWith>>(base: C, block: bigint): C => {
+    let first = true;
+    return { ...base, getBlock: (n: bigint) => {
+      if (n !== block || !first) return base.getBlock(n);
+      first = false;
+      return Promise.resolve({ number: n, hash: blockHash(Number(n) + 7_000_000) as Hex, parentHash: blockHash(Number(n) - 1) as Hex });
+    } };
+  };
+  const strangerAt = (block: number, index: number) => makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(generateKeySet()), block, index, caller: FAKE_ROUTER }).log;
+
+  it('H1: a window-end reorg stopped by the announcement limit keeps the stored recheck list and rescan block, without the anchor', async () => {
+    const s = setup(); const cp = memStore();
+    // Two announcements in [2000, 3000), the windows the fork leaves valid: more than the per-run limit of 1.
+    const client = windowEndFork(chainWith(HEAD, [strangerAt(2500, 0), strangerAt(2600, 1)]), 3999n);
+    cp.store.save(chain.chainId, KEY, { nextBlock: START, last: ANCHOR, recheck: [1000n], rescanFrom: 900n });
+    const reorgs: bigint[] = [];
+    const res = await scan(s, { client, checkpoints: cp.store, cursor: cp.store.load(chain.chainId, KEY)!, maxAnnouncementsPerScan: 1, onReorg: (to) => { reorgs.push(to); } });
+    expect(reorgs).toEqual([3000n]);
+    expect(res.limitReached).toBe(true);
+    // Not cleared: block 1000 keeps its retry and the rescan block (the notice the view shows) survives a reload.
+    expect(cp.reload().load(chain.chainId, KEY)).toEqual({ nextBlock: START, recheck: [1000n], rescanFrom: 900n });
+    expect(cp.saves.at(-1)).not.toHaveProperty('last');
+  });
+
+  it('H1: a reorg stop carries this run\'s owed blocks below the rollback, as at any save', async () => {
+    const s = setup(); const cp = memStore();
+    const meta = encodeMetaAddress(s.keys);
+    // Page 1 (0..49,999) finds a router claim at 1000 whose check fails in transit; page 2 forks at its second window
+    // and is deferred by the open-lane budget (page 1 used it up).
+    const claim = makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: meta, block: 1000, index: 0, caller: FAKE_ROUTER });
+    const spam = [makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(generateKeySet()), block: 10, index: 0, caller: DIRECT }).log,
+      makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(generateKeySet()), block: 50_500, index: 0, caller: DIRECT }).log];
+    const base = chainWith(HEAD, [claim.log, ...spam]);
+    const failing: ReturnType<typeof chainWith> = { ...base, request: (method, params) => (method === 'eth_getTransactionReceipt' ? Promise.reject(new ChainAdapterError('RPC_FAILURE', 'timeout')) : base.request(method, params)) };
+    const res = await scan(s, { client: windowEndFork(failing, 51_999n), checkpoints: cp.store, openLaneBudget: 1 });
+    expect(res.backlog).toBe(1);
+    expect(res.matches.map((m) => [m.announcement.blockNumber, m.receipt, m.recheck])).toEqual([[1000n, 'claimed', true]]);
+    expect(cp.saves.at(-1)).toEqual({ nextBlock: 50_000n, recheck: [1000n] });
+    expect(cp.reload().load(chain.chainId, KEY)).toEqual({ nextBlock: 50_000n, recheck: [1000n] });
+  });
+
+  it('H1: a reorg stop caps and counts the owed blocks as any save does, and reports the overflow with its progress', async () => {
+    const s = setup(); const cp = memStore();
+    const meta = encodeMetaAddress(s.keys);
+    // Page 1 (0..49,999): 10 router claims whose check fails in transit (8 kept, 2 dropped). Page 2 forks at its second
+    // window and is deferred by the open-lane budget, which page 1 used up.
+    const claims = Array.from({ length: 10 }, (_, i) => makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: meta, block: 1000 + 2000 * i, index: 0, caller: FAKE_ROUTER }));
+    const blocks = claims.map((_, i) => BigInt(1000 + 2000 * i));
+    const spam = [makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(generateKeySet()), block: 10, index: 0, caller: DIRECT }).log,
+      makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(generateKeySet()), block: 50_500, index: 0, caller: DIRECT }).log];
+    const base = chainWith(HEAD, [...claims.map((x) => x.log), ...spam]);
+    const failing: ReturnType<typeof chainWith> = { ...base, request: (method, params) => (method === 'eth_getTransactionReceipt' ? Promise.reject(new ChainAdapterError('RPC_FAILURE', 'timeout')) : base.request(method, params)) };
+    const progress: ScanProgress[] = [];
+    const res = await scan(s, { client: windowEndFork(failing, 51_999n), checkpoints: cp.store, openLaneBudget: 1, onProgress: (x) => progress.push(x) });
+    expect(res.backlog).toBe(1);
+    expect(cp.saves).toEqual([
+      { nextBlock: 50_000n, last: { number: 49_999n, hash: blockHash(49_999) }, recheck: blocks.slice(0, RECHECK_MAX), rescanFrom: 1000n },
+      // The anchor-less replacement: the stored list plus this run's dropped blocks, capped again to the same 8.
+      { nextBlock: 50_000n, recheck: blocks.slice(0, RECHECK_MAX), rescanFrom: 1000n },
+    ]);
+    // Every claim behind this run's own rescan block is in this run's matches: the count stays known.
+    expect(res.recheckOverflow).toEqual({ count: 2, fromBlock: 1000n });
+    expect(progress.at(-1)).toMatchObject({ backlog: 1, recheckOverflow: { count: 2, fromBlock: 1000n } });
+    expect(progress.at(-1)?.recheckOverflow).not.toHaveProperty('countKnown');
+  });
+
+  it('H2: the announcement limit on a window-end reorg page holds the cursor at the page start; a payment there is found on resume', async () => {
+    const s = setup(); const cp = memStore();
+    const paid = makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(s.keys), block: 2500, index: 0, caller: FAKE_ROUTER });
+    const logs = [paid.log, strangerAt(2600, 1)];
+    cp.store.save(chain.chainId, KEY, { nextBlock: START, last: ANCHOR });
+    const res = await scan(s, { client: windowEndFork(chainWith(HEAD, logs), 3999n), checkpoints: cp.store, cursor: cp.store.load(chain.chainId, KEY)!, maxAnnouncementsPerScan: 1 });
+    expect(res.limitReached).toBe(true);
+    // The fork is at 3000, but [2000, 3000) was never processed: neither cursor may pass the page start.
+    expect(res.cursor.nextBlock).toBeLessThanOrEqual(START);
+    expect(cp.store.load(chain.chainId, KEY)?.nextBlock).toBeLessThanOrEqual(START);
+    const resumed = await scan(s, { client: chainWith(HEAD, logs), checkpoints: cp.store, cursor: cp.store.load(chain.chainId, KEY)! });
+    expect(resumed.matches.map((m) => [m.announcement.blockNumber, m.receipt])).toEqual([[2500n, 'verified']]);
+  });
+
+  it('H2: an open-lane deferral on a window-end reorg page holds the cursor at the page start; a direct payment there is found on resume', async () => {
+    const s = setup(); const cp = memStore();
+    // Page 1 (0..49,999) uses the open-lane budget; page 2 starts at 50,000 and forks at its second window (51,000).
+    const spam = makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(generateKeySet()), block: 10, index: 0, caller: DIRECT }).log;
+    const direct = makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(s.keys), block: 50_600, index: 0, caller: DIRECT });
+    const logs = [spam, direct.log];
+    const res = await scan(s, { client: windowEndFork(chainWith(HEAD, logs), 51_999n), checkpoints: cp.store, openLaneBudget: 1 });
+    expect(res.backlog).toBe(1);
+    expect(res.cursor.nextBlock).toBeLessThanOrEqual(50_000n);
+    expect(cp.store.load(chain.chainId, KEY)?.nextBlock).toBeLessThanOrEqual(50_000n);
+    const resumed = await scan(s, { client: chainWith(HEAD, logs), checkpoints: cp.store, openLaneBudget: 1, cursor: cp.store.load(chain.chainId, KEY)! });
