+    const near = makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: meta, block: 2495, index: 0, caller: FAKE_ROUTER });
+    const base = chainWith(2500, [claim.log, near.log]);
+    const claimTx = claim.log.transactionHash!.toLowerCase();
+    let heads = 0;
+    const client: ReturnType<typeof chainWith> = {
