+
+  it('H2: a provider disagreement on a window-end reorg page holds the cursor at the page start, and the page is compared from its start', async () => {
+    const s = setup(); const cp = memStore();
+    const paid = makeLog({ announcer: FAKE_ANNOUNCER, metaAddress: encodeMetaAddress(s.keys), block: 2500, index: 0, caller: FAKE_ROUTER });
+    const logs = [paid.log];
+    const id = `${paid.log.blockHash}:${String(Number(BigInt(paid.log.logIndex)) + 100)}`;
+    // The second provider agrees on [2000, 2999] when the reorg page is first compared, and has lost the payment when the
+    // page is compared again before its matches are exposed.
+    const second = chainWith(HEAD, logs);
+    let pageReads = 0;
+    const secondary: ReturnType<typeof chainWith> = { ...second, getLogs: async (f) => {
+      const out = await second.getLogs(f);
+      if (f.address.toLowerCase() !== FAKE_ANNOUNCER.toLowerCase() || f.fromBlock !== START) return out;
+      return ++pageReads === 1 ? out : [];
+    } };
+    cp.store.save(chain.chainId, KEY, { nextBlock: START, last: ANCHOR });
+    const reorgs: bigint[] = [];
+    const res = await scan(s, { client: windowEndFork(chainWith(HEAD, logs), 3999n), secondaryClient: secondary, checkpoints: cp.store, cursor: cp.store.load(chain.chainId, KEY)!, onReorg: (to) => { reorgs.push(to); } });
+    // Both comparisons asked the second provider about the page from its start (2000), not from the fork (3000).
+    expect(pageReads).toBe(2);
+    expect(reorgs).toEqual([3000n]);
+    expect(res.discrepancies).toEqual([{ kind: 'missing_in_secondary', ref: id }]);
+    expect(res.matches).toEqual([]);
+    expect(res.cursor.nextBlock).toBeLessThanOrEqual(START);
+    expect(cp.store.load(chain.chainId, KEY)?.nextBlock).toBeLessThanOrEqual(START);
+    const resumed = await scan(s, { client: chainWith(HEAD, logs), secondaryClient: chainWith(HEAD, logs), checkpoints: cp.store, cursor: cp.store.load(chain.chainId, KEY)! });
+    expect(resumed.discrepancies).toEqual([]);
+    expect(resumed.matches.map((m) => [m.announcement.blockNumber, m.receipt])).toEqual([[2500n, 'verified']]);
