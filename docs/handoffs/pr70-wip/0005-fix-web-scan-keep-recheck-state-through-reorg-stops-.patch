+  it('M1: a pending match at or after the saved nextBlock is not owed, so a lower owed block keeps its retry after a reload', async () => {
+    const s = setup(); const cp = memStore();
+    const meta = encodeMetaAddress(s.keys);
+    // Block 120: a router claim whose check fails in transit (owed). Block 2495: a real payment the check sees as pending
