+    expect(res.limitReached).toBe(true);
+    expect(res.cursor.nextBlock).toBeLessThanOrEqual(START);
+    expect(cp.reload().load(chain.chainId, KEY)).toEqual({ nextBlock: START, recheck: [1000n], rescanFrom: 900n });
