      "findings": [
        {
          "id": "IDLE-R2-DOC-01",
          "severity": "low",
          "blocking": false,
          "path": "docs/guides/troubleshooting-by-symptom.md",
          "scope": "Live guidance rows under My keys or tags are gone",
          "description": "The legacy guidance still counts a downloaded keystore as a recoverable idle copy and suggests a typed waiver can allow invoicing after unsaved keys survive idle. The recovered runtime requires a verified external copy for disposal and leaves a retained sole copy suspended with only encrypted backup/save/verification available.",
          "recommended_change": "Update the two key/idle rows to distinguish a verified copy from an unverified download, describe suspended encrypted recovery, and require normal import or vault unlock to resume ordinary authority. Preserve the original source qualification checkpoint; this can be a documentation-only follow-up.",
          "status": "Reported to root and author; nonblocking for runtime qualification."
        }
      ],
      "assessed_invariants": [
        "Idle lock increments session revision and suspends ordinary access before vault reads or view notifications; pending empty-session imports and captured operations become stale.",
        "Ordinary synchronous/async secret borrowing and key guards evaluate the current idle deadline, including a promise continuation before browser events. Async temporary copies are tracked and wiped on suspension or clear, and stale results are refused.",
        "Encrypted-only recovery uses a separately scoped guard for encrypted export, vault save and backup verification. It does not resume ordinary signing/scanning/spending; normal installation clears suspension and starts a new lease.",
        "Clock observations are sampled once as a finite nonnegative pair; either elapsed deadline or rollback revokes. Session identity, active-effect flag, timer revision and lock revision guard queued callbacks and late custody results.",
        "Activity after expiry cannot renew ordinary authority. Post-lock input renews only transient recovery-form cleanup, preserving the pending custody-decision identity.",
        "Current private-checkpoint cache token checks active authority; the lender rechecks holder identity after borrowing and wipes refused temporary copies.",
        "The SellerKeys automatic merge changes imports, subscription and visibility wrappers only. The full state/operation-handler region, including unlockBusy/vaultWriteBusy separation, is byte-identical to325.",
        "Current Sweep source/helpers/tests, scanner/tag-scope code and dependency/configuration files are unchanged by the recovery.",
        "The archive regression preserves mounted input-scrubbing assertions and separately checks actual expiry hides the archive, removes input values, retains the exact sole copy and permits only encrypted recovery.",
        "Existing locale metadata and 2,269 message values per locale remain exact; only four idle notices were added. All nonempty parent ownership lines remain present.",
        "A normal merge retains current #325, tests-only checkpoint and donor256 ancestry. All 24 changed files have mode 100644; no workflow, dependency, contract, crypto/KDF or release configuration changes."
      ],
      "browser_fixture_review": {
        "core_initialization": "newProfile installs the mock clock and creates a blank page. openPayer only injects the wallet. The expiresAt\u2212300seconds anchor therefore runs before AppShell is mounted. reviewToFinalCheck invokes openFresh, which navigates about:blank and then the invoice URL.",
        "pages_initialization": "The separate clocked payer context is created without changing the seller context. openPayer only creates a page/injects its wallet. Clock installation at expiresAt\u2212300seconds precedes openFresh.",
        "deadline_isolation": "Each fixture advances to signed expiresAt + 300 seconds after final review. Ten wall-clock minutes cross invoice expiry within the unchanged 15-minute idle interval.",
        "preserved_assertions": [
          "Exact expired-invoice message",
          "No Submitted heading",
          "Zero wallet requests/transactions",
          "Empty payment journal in core journey",
          "Expired invoice reopening refuses Continue",
          "Pages nonce/dry-run/on-chain expiry assertions unchanged"
        ],
        "execution_limit": "Source ordering is verified; the corrected full/lean browser journeys have not been executed by this reviewer and remain hosted qualification gates."
      },
      "qualifications_required": [
        "Run complete original idle/AppShell/session/keyVault/checkpoint/archive/SellerKeys and preserved Sweep integration regression selections on the combined product source.",
        "Run applicable original TypeScript, typed lint and build checks without weakening thresholds or policies.",
        "Execute actual current-head full/lean browser and other required hosted/security checks before promotion; source approval and historical donor passes do not substitute.",
        "Bind any later source correction to fresh review/qualification; documentation-only follow-ups may retain the product-source pin with exact tree provenance."
      ]
    },
